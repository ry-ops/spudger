# Spudger — device configuration TEMPLATE
#
# Copy this to `device.local.env` and fill in YOUR device's values:
#     cp device.example.env device.local.env
#
# `device.local.env` is gitignored and must NEVER be committed — it holds
# device-identifying values (DUID, Wi-Fi MAC, LAN IPs). The tools in tools/
# source it automatically when present, and the docs refer to it by name.

TV_IP=192.0.2.10                 # your TV's LAN IP  (curl -s http://<ip>:8001/api/v2/)
TV_PORT=26101                    # sdb debug port (default)
TV_DUID=uuid:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX   # from :8001/api/v2 -> duid; needed for the distributor cert
TV_WIFI_MAC=XX:XX:XX:XX:XX:XX    # from :8001/api/v2 -> wifiMac
TV_MODEL=QN43Q60DAFXZA           # product model (public)
CERT_PROFILE=SamsungTV           # your Samsung security profile name
VOLUMIO_URL=http://192.0.2.20    # your Volumio host (HTTP + explicit IP; the TV has no mDNS)
