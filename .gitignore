# Never commit signing material or secrets
*.p12
*.pwd
*.key
*.pem
author-signature.xml
signature*.xml
.manifest.tmp
SamsungCertificate/
secrets.env
*.local

# Private, device-identifying config (DUID, Wi-Fi MAC, LAN IPs) — never commit.
